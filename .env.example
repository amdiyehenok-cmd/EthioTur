# Server-only secrets — copy to .env.local and fill in real values.
# NEVER commit .env.local. Every value here is read on the server only.

# PostgreSQL connection string.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5433/ethiopia_unfolded

# Canonical public origin, used for metadata, sitemap and structured data.
# Use the real HTTPS production domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin sign-in token. At least 32 random characters. Keep it in the
# deployment's secret store. Never prefix it with NEXT_PUBLIC_.
ADMIN_API_TOKEN=replace-with-at-least-32-random-characters

# Independent secret used to sign admin session cookies. Falls back to
# ADMIN_API_TOKEN when unset. At least 32 random characters.
ADMIN_SESSION_SECRET=replace-with-a-different-32-character-secret

# Optional. Enables the server-side OpenAI Chat Completions integration for
# the travel concierge. When absent the concierge uses its deterministic,
# source-linked fallback. The key is never sent to the browser.
OPENAI_API_KEY=

# Optional model identifier for the concierge.
OPENAI_MODEL=gpt-4o-mini
